#!/usr/bin/env bash

set -euo pipefail

usage() {
    echo "Usage: devfriction port <port>"
    echo
    echo "Inspect and safely terminate a process using a network port."
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    usage
    exit 0
fi

if [[ $# -ne 1 ]]; then
    echo "Error: a port number is required." >&2
    echo
    usage >&2
    exit 2
fi

PORT="$1"

if [[ ! "$PORT" =~ ^[0-9]+$ ]]; then
    echo "Error: port must be a number." >&2
    exit 2
fi

if (( 10#$PORT < 1 || 10#$PORT > 65535 )); then
    echo "Error: port must be between 1 and 65535." >&2
    exit 2
fi

PORT=$((10#$PORT))

if ! command -v lsof >/dev/null 2>&1; then
    echo "Error: 'lsof' is required but was not found." >&2
    exit 1
fi

PID="$(lsof -nP -iTCP:"$PORT" -sTCP:LISTEN -t 2>/dev/null || true)"

if [[ -z "$PID" ]]; then
    echo "Port $PORT is not in use."
    exit 0
fi

PROCESS="$(ps -p "$PID" -o comm= 2>/dev/null || true)"

echo "Checking port $PORT..."
echo
echo "Port:    $PORT"
echo "Status:  IN USE"
echo "Process: ${PROCESS:-unknown}"
echo "PID:     $PID"
echo

read -r -p "Terminate this process? [y/N]: " CONFIRM

case "$CONFIRM" in
    y|Y|yes|YES)
        ;;
    *)
        echo "No action taken."
        exit 0
        ;;
esac

echo
echo "Sending SIGTERM..."

if ! kill -TERM "$PID" 2>/dev/null; then
    echo "Error: failed to send SIGTERM to PID $PID." >&2
    exit 1
fi

echo "Waiting for process to exit..."

for _ in {1..20}; do
    if ! kill -0 "$PID" 2>/dev/null; then
        echo "Port $PORT is now available."
        exit 0
    fi

    sleep 0.25
done

echo "Process is still running after SIGTERM."
echo "No forceful termination was attempted."

exit 1