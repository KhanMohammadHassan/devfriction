#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

COMMAND="${1:-}"

case "$COMMAND" in
    hello)
        exec "$PROJECT_ROOT/libexec/devfriction-hello"
        ;;
    port)
        shift
        exec "$PROJECT_ROOT/libexec/devfriction-port" "$@"
        ;;
    security)
        shift

        case "${1:-}" in
            exposure)
                shift

                case "${1:-}" in
                    list)
                        shift
                        exec "$PROJECT_ROOT/libexec/devfriction-security-exposure-list" "$@"
                        ;;
                    *)
                        echo "Usage: devfriction security exposure list"
                        exit 2
                        ;;
                esac
                ;;
            *)
                echo "Usage: devfriction security exposure <command>"
                exit 2
                ;;
        esac
        ;;
    "")
        echo "Usage: devfriction <command>"
        echo
        echo "Commands:"
        echo "  hello     Test that devfriction is working"
        echo "  port      Inspect a process using a network port"
        echo "  security  Security inspection commands"
        ;;
    *)
        echo "devfriction: unknown command: $COMMAND" >&2
        echo "Run 'devfriction' to see available commands." >&2
        exit 2
        ;;
esac
#LF
